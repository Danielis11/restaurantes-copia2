# ===== Copia este archivo como .env y llena los valores =====
NODE_ENV=production
PORT=3003

# MongoDB Atlas
MONGODB_URI=
# MONGODB_URI_HOSPEDAJES ya no se usa: los hospedajes viven en la base principal

# Secreto para firmar sesiones (OBLIGATORIO, mínimo 32 caracteres aleatorios)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox (token público pk.*, restríngelo a tu dominio en mapbox.com)
MAPBOX_TOKEN=

# DeepL (traducciones)
DEEPL_API_KEY=

# Login con Google
GOOGLE_CLIENT_ID=

# Correo para recuperación de contraseña (contraseña de aplicación de Gmail)
EMAIL_USER=
EMAIL_PASS=

# Opcional: dominios permitidos para llamar a la API, separados por coma
# CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Opcional: permitir que cualquiera se registre como admin de restaurante (por defecto NO)
# ALLOW_ADMIN_SELF_REGISTER=false

# Dominio público del sitio (para sitemap, canonical y vistas previas al compartir)
# Si no se define, se usa el dominio con el que llega cada visita
# SITE_URL=https://tudominio.com
